# 主线 B E2E 配置。复制到仓库根目录 .env（已在 .gitignore），或直接 export。
# 账号：运行前用 autotest-account MCP 领取 acquire_account(platformCode="bot", environmentCode="dev", accountTypeCode="growth")
#       → accountName / password 填到下面；跑完 release_account(accountId, lockToken)。不要把真实凭据提交进仓库。

# ---------- 环境声明（BDD 0.1）----------
# 被测环境是否已经是「concierge 只对白名单商家开放」（与 prod 同形态）。不是 1 → 所有店铺类用例 skip
E2E_CONCIERGE_WHITELIST_ONLY=0
# 只给 specs/baseline（改造前现状基线）用：跑 baseline 时设 off。改造后用例不看它（09-28 定：不要开关）
E2E_METERING_SWITCH=off
# 改造后代码部署到被测环境的时刻（ISO，UTC）。B1-1 / B4-2 / D-1 / P-2 / P-3 用（prod 时填 prod 发版时刻）
E2E_DEPLOYED_AT=
# dev | prod。prod 用例（B6-* / P-*）只在 prod 且显式允许时跑
E2E_TARGET=dev
E2E_ALLOW_PROD_READONLY=0

# ---------- 地址 ----------
YEPAI_BASE_URL=https://bot-dev.yepai.io
# chatbot-api 对外地址（挂件实测：api-test.yepai.io/dev）
CHATBOT_API_BASE=https://api-test.yepai.io/dev
WIDGET_SCRIPT_URL=https://widget.yepai.io/chat-widget.js
WIDGET_ORIGIN=https://chat-bot-dev.yepai.ai
# yepairag 直连地址（B7-*）。默认集群内 http://yepairag-dev.llm:8080；本机跑需 kubectl port-forward 后改成 localhost
YEPAIRAG_BASE_URL=
# yepairag 对外 ASR 地址（B9-3，挂件实测）
YEPAIRAG_PUBLIC_ASR_URL=https://api-test.yepai.io/dev/yepairag/api/asr

# ---------- 测试商家 ----------
# 新套餐（BDD 0.2：1213401795527716864）；Email Collection 必须已关
E2E_NEW_EMAIL=
E2E_NEW_PASSWORD=
E2E_NEW_TENANT=1213401795527716864
E2E_NEW_SHOP=
# 老套餐（918807096909901824，已发 7000 止血额度）
E2E_LEGACY_EMAIL=
E2E_LEGACY_PASSWORD=
E2E_LEGACY_TENANT=918807096909901824
E2E_LEGACY_SHOP=
# 白名单（1157962189542760448，走 concierge）
E2E_WHITELIST_EMAIL=
E2E_WHITELIST_PASSWORD=
E2E_WHITELIST_TENANT=1157962189542760448
E2E_WHITELIST_SHOP=
# 零余额新套餐（Q9，待准备）
E2E_ZERO_EMAIL=
E2E_ZERO_PASSWORD=
E2E_ZERO_TENANT=
E2E_ZERO_SHOP=
# 非 Shopify 新套餐（B5-4，Q9）
E2E_NONSHOPIFY_TENANT=
E2E_NONSHOPIFY_SHOP=
E2E_NONSHOPIFY_EMAIL=
E2E_NONSHOPIFY_PASSWORD=

# ---------- 后端检查（只读）----------
# W23 库（digitalstaff-dev，schema digital-staff-su + litellm），只读账号。需要本机有 psql
W23_DATABASE_URL=
# yepairag 库（chat_memory.events，B3-5 / B4 基线 / P-2 对账）
YEPAIRAG_DATABASE_URL=
# kubectl logs 参数（整串原样传给 kubectl logs），例：--context oldeks -n llm -l app=yepairag-dev --max-log-requests 10
YEPAIRAG_LOGS=
CHATBOT_LOGS=
LITELLM_LOGS=
# 读 chatbot 配置：kubectl get 的参数，例：--context oldeks -n bigdata configmap/chatbot-api-dev-configmap
CHATBOT_CONFIGMAP=
# 被测环境 yepairag 的两个模型别名（W23 round3：dev=gemini-flash-latest，prod=gemini-2.5-flash；STABLE=gemini-3-flash-preview）
PREMIUM_LLM_MODEL=gemini-flash-latest
PREMIUM_LLM_MODEL_STABLE=gemini-3-flash-preview
EMBEDDING_MODEL=text-embedding-3-large

# ---------- 按场景的附加配置（不填 → 对应用例 skip）----------
# B1-4：已确认测试商家授予 read_legal_policies 且 7 天内没同步过
E2E_POLICY_SYNC_READY=0
# B2-2：一次 /collect 定时任务的开始时间（ISO），用来圈日志
E2E_COLLECT_RUN_AT=
# B7-3 / B7-4：/responseV3 请求体（JSON，W32 未给）、「MCP 请求特征」请求头（JSON，未定义）；B7-3 / B7-5 用的商家 vkey
E2E_RESPONSEV3_BODY=
E2E_MCP_LIKE_HEADERS=
E2E_NEW_MERCHANT_VKEY=
# B9：真实英文录音 "Do you ship to Australia"（wav）。不填则在 macOS 上用 say 现场生成
E2E_ASR_WAV=

# ---------- 需要改部署的用例（默认关，要单独授权）----------
# B3-5：dev 部署了不含第 3 项的 yepairag 镜像且开关打开
E2E_B35_DEPLOYED=0
# B3-6 / B4-3：已按 BDD 注入故障。before = GOOGLE_GEMINI_BASE_URL mock；after = dev LiteLLM 测试 alias + mock
E2E_FAULT_INJECTION=

# ---------- 零余额商家的预置数据（B2-6；零余额时无法现场造）----------
E2E_ZERO_INBOX_MARKER=
E2E_ZERO_KB_ITEM=
ASR_MODEL=whisper-1

# ---------- prod 只读核对（B6-* / P-*，每次运行都要人类授权）----------
LITELLM_PROD_BASE_URL=
LITELLM_PROD_TEST_VKEY=
LITELLM_PROD_INTERNAL_URL=
# B6-2 需要 kubectl exec 进 prod pod，单独授权
E2E_ALLOW_PROD_EXEC=0
YEPAIRAG_PROD_EXEC=
# P-1：kubectl get 参数（例：--context prod -n llm deploy/yepairag-prod）、本地仓库路径、必须包含的提交（逗号分隔）
YEPAIRAG_PROD_DEPLOY=
CHATBOT_PROD_DEPLOY=
YEPAIRAG_REPO=
CHATBOT_REPO=
E2E_REQUIRED_COMMITS_YEPAIRAG=
E2E_REQUIRED_COMMITS_CHATBOT=
# P-3：MCP 工具成功率的 SQL（口径未定，Q16）
E2E_MCP_SUCCESS_SQL=
E2E_ZERO_COLLECT_RUN_AT=


# B9-4：旧版挂件脚本的固定版本 URL（Q20 余项）
E2E_OLD_WIDGET_SCRIPT_URL=

# ---------- 第 6 项 LiteLLM（specs/infra-litellm.spec.ts）----------
# kubectl exec 目标（在 pod 内用 $LITELLM_MASTER_KEY 调 localhost:4000，不回显 key）。不填 → IL 全部 skip
LITELLM_EXEC='--context oldeks -n zeroclaw deploy/litellm'
# W30 apply configmap/deployment + 重启后设 1：打开 IL-1~IL-5，关掉 IL-BL（改造前基线）
E2E_INFRA_LITELLM_DEPLOYED=0
